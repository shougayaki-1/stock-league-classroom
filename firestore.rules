rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function teacher() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function operator() { return teacher() && request.auth.token.operator == true; }
    // Retained until the new lesson-run emergency control is introduced.
    function serviceOpen() {
      return !exists(/databases/$(database)/documents/serviceStatus/global)
        || get(/databases/$(database)/documents/serviceStatus/global).data.acceptingNewMarkets != false;
    }

    match /serviceStatus/{documentId} {
      // It contains no personal data, so the maintenance notice is readable
      // before sign-in. Only operators may change it.
      allow get: if true;
      allow list: if false;
      allow write: if operator();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
