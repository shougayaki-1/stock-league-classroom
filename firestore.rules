rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function teacher() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function operator() { return teacher() && request.auth.token.operator == true; }
    // Retained until the new lesson-run emergency control is introduced.
    function serviceOpen() {
      return !exists(/databases/$(database)/documents/serviceStatus/global)
        || get(/databases/$(database)/documents/serviceStatus/global).data.acceptingNewMarkets != false;
    }

    match /serviceStatus/{documentId} {
      // It contains no personal data, so the maintenance notice is readable
      // before sign-in. Only operators may change it.
      allow get: if true;
      allow list: if false;
      allow write: if operator();
    }

    // Firestore is the source of truth for organization membership. Future
    // resource rules require this active status; membership-status reads stay
    // separate so suspended users can still see their own status.
    function activeMember(orgId) {
      return exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.status == 'active';
    }

    match /users/{uid} {
      // Set only by server-side organization provisioning.
      allow get: if teacher() && uid == request.auth.uid;
      allow list: if false;
      allow write: if false;
    }

    match /organizations/{orgId} {
      // Membership-based from the outset, including future school orgs with
      // more than one active member.
      allow get: if teacher() && activeMember(orgId);
      allow list: if false;
      allow write: if false;
    }

    match /organizations/{orgId}/members/{uid} {
      // Resource rules, rather than this status document, deny suspended
      // members. They may always inspect their own membership status.
      allow get: if teacher() && uid == request.auth.uid;
      allow list: if false;
      allow write: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
