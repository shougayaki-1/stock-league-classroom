rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function teacher() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function activeMember(orgId) {
      return firestore.exists(/databases/(default)/documents/organizations/$(orgId)/members/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.status == 'active';
    }
    function materialsEnabled(orgId) {
      return firestore.exists(/databases/(default)/documents/organizations/$(orgId))
        && firestore.get(/databases/(default)/documents/organizations/$(orgId)).data.materialsUploadEnabled == true;
    }
    match /orgs/{orgId}/materials/{materialId}/{fileName} {
      allow read: if teacher() && activeMember(orgId) && materialsEnabled(orgId);
      allow write: if teacher() && activeMember(orgId) && materialsEnabled(orgId)
        && request.resource.size <= 10 * 1024 * 1024
        && (request.resource.contentType == 'application/pdf' || request.resource.contentType == 'text/plain');
    }
    match /orgs/{orgId}/materials/{templateId}/{materialId}/{fileName} {
      allow read: if teacher() && activeMember(orgId) && materialsEnabled(orgId);
      allow write: if teacher() && activeMember(orgId) && materialsEnabled(orgId)
        && request.resource.size <= 10 * 1024 * 1024
        && (request.resource.contentType == 'application/pdf' || request.resource.contentType == 'text/plain');
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
